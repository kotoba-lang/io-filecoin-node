;; One dependency. io-filecoin already owns the address, CID, CBOR-amount and
;; message encodings a node needs, and it brings org-ietf-blake2,
;; io-multiformats, org-ietf-cbor and json with it. A node-side library that
;; re-implemented `filecoin.address` would be a second answer to what an `f1…`
;; means, which is the failure ADR-2607254100 records six times over.
;;
;; Still no secp256k1, no BLS12-381, no libp2p: verifying a block signature is
;; a seam (`filecoin.node.protocols/IVerifier`), because a pairing-friendly
;; curve is not something to write on the way to a header codec.
{:paths ["src"]
 :deps {io.github.kotoba-lang/io-filecoin
        {:git/sha "fb130b17e790d2aa1cccb925306af9e36e58db20"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts — `clojure -A:cljs -Spath` resolves the git
  ;; deps for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
