;; One dependency. io-filecoin already owns the address, CID, CBOR-amount and
;; message encodings a node needs, and it brings org-ietf-blake2,
;; io-multiformats, org-ietf-cbor and json with it. A node-side library that
;; re-implemented `filecoin.address` would be a second answer to what an `f1…`
;; means, which is the failure ADR-2607254100 records six times over.
;;
;; Still no secp256k1, no BLS12-381, no libp2p: verifying a block signature is
;; a seam (`filecoin.node.protocols/IVerifier`), because a pairing-friendly
;; curve is not something to write on the way to a header codec.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-filecoin
        {:git/sha "5cae99bfd68e28518db28edf8df0eac88336d3ba"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts — `kbb -A:cljs -Spath` resolves the git
  ;; deps for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
